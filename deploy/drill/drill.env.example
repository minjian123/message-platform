# 六类故障演练的宿主侧键位（任务 07-6-1）
#
# 用法：把本文件复制成你自己的 shell 片段（不要提交真实地址与凭据），
# 导出后在 backend/ 下执行：
#   python -m ops.drill plan
#   python -m ops.drill run process_crash --confirm process_crash
#
# 键位单一事实源在 `bms_msg/core/config.py` 的「07-6-1 故障演练」段；
# 本文件不参与 `deploy/.env.example` 的敏感键注册表（演练键位与部署键位彻底分开）。

# --- 必填 -------------------------------------------------------------------
# 演练工作根：临时数据根、SQLite 元数据库、签名密钥、实例日志、填充文件都在其下。
MSG_DRILL_WORK_DIR=tmp/drill

# --- 常用可调 ---------------------------------------------------------------
# 环境标识；prod / production 一律硬拒绝（无逃生开关）。
MSG_DRILL_ENV=test

# 隔离实例起始端口（只绑 127.0.0.1；占用则从该端口向后探测）。
MSG_DRILL_BASE_PORT=18080

# 记录落点（相对仓根）；JSON 与 Markdown 同名不同后缀。
MSG_DRILL_REPORT_DIR=tmp/drill

# 单场景恢复预算（毫秒）；超预算判失败。
MSG_DRILL_RECOVERY_BUDGET_MS=240000

# 磁盘满场景的受控填充量（MiB）；小盘会按总容量的 0.04% 自动放大。
MSG_DRILL_FILL_MB=64

# 慢盘场景的受控写入量（MiB，循环覆盖写同一文件并 fsync）。
MSG_DRILL_SLOW_WRITE_MB=128

# 磁盘满场景的拒绝水位（0~1，仅供手工直启实例时参考）：脚本会按当前磁盘用量
# 自动算出「告警 + 拒绝」成对阈值，一般不必手填。
MSG_DRILL_REJECT_RATIO=0.0001

# --- 非隔离环境必填 ---------------------------------------------------------
# 非 test / dev / local 环境必须给演练前备份证据（备份批次或备份文件标识），否则拒绝执行。
# MSG_DRILL_BACKUP_EVIDENCE=backup-20261111-093000
