# 集群演练环境模板（02-8；复制为 drill/cluster.env 使用；本文件不含真实地址 / 凭据）
#
# 用途：`ops.cluster_drill` 通过 SSH 在开发服务器上构建镜像、起三实例、注入故障；本文件只给键位。
# 纪律：真实主机 / 账号 / 密钥只落 `drill/cluster.env`（已 gitignore），不入库、不写日志。

# ===== 远程执行 =====
# SSH 目标（形如 user@host）与端口；免密登录由本机 ssh 配置提供
MSG_CLUSTER_DRILL_SSH_TARGET=
MSG_CLUSTER_DRILL_SSH_PORT=22
# 服务器上的临时工作区（源码同步、镜像构建、演练记录都落在这里）
MSG_CLUSTER_DRILL_WORK_DIR=
# 镜像标签（含 msg 提交短号；缺省由编排器按 git 短号生成）
MSG_CLUSTER_DRILL_IMAGE_TAG=

# ===== 演练环境隔离 =====
# 环境标识（prod / production 一律拒绝）
MSG_CLUSTER_DRILL_ENV=test
# compose 项目名 / 容器名前缀 / 独立网络 / 演练库前缀
# 库名前缀同时覆盖 `msg.yml` 写死的 `BMS_DATABASE__NAME_PREFIX=msg`（见 msg-drill.override.yml）：
# 平台库 = `{前缀}_msg`、租户库 = `{前缀}_msg_{租户}`、归档库见下方 ARCHIVE__URL
MSG_CLUSTER_DRILL_PROJECT=msg-drill
MSG_CLUSTER_DRILL_DB_PREFIX=msgdrill
# 本机 SSH 隧道使用的服务器回环端口（三实例各一；与 msg-drill.override.yml 同键）
MSG_CLUSTER_DRILL_PORT_1=18800
MSG_CLUSTER_DRILL_PORT_2=18801
MSG_CLUSTER_DRILL_PORT_3=18802

# ===== 镜像引用（手工 compose 时必填；`ops.cluster_drill` 按提交短号自动注入同名键）=====
# 镜像全名 = `<MSG_REGISTRY_IMAGE_PREFIX>/msg:<MSG_TAG>`；本地构建不经 Registry
MSG_REGISTRY_IMAGE_PREFIX=drill
MSG_TAG=

# ===== 演练库 / 依赖（仅演练环境；不得指向生产库）=====
# cleanup 会 DROP 掉所有 `{MSG_CLUSTER_DRILL_DB_PREFIX}_*` 库，因此：
# - 演练库账号需对 `{前缀}_%` 具备 DROP 权限（建库时授 `GRANT ALL ON \`{前缀}_%\`.*`）；
# - BMS_REDIS__URL 必须指向**非 0 号库**（cleanup 拒绝 flush 0 号库，防误清生产）；
# - 想保留数据请用 `ops.cluster_drill cleanup --keep-data`。
BMS_DATABASE__PLATFORM__URL_TEMPLATE=
BMS_DATABASE__PLATFORM__PASSWORD=
BMS_DATABASE__TENANTS__URL_TEMPLATE=
BMS_DATABASE__TENANTS__PASSWORD=
BMS_DATABASE__ARCHIVE__URL=
BMS_DATABASE__ARCHIVE__PASSWORD=
BMS_REDIS__URL=
BMS_TRACER__OTLP_ENDPOINT=
BMS_SERVICE_TOKEN__KEYS=
BMS_SERVICE_TOKEN__ACTIVE_KID=
BMS_SECURITY__KEYS=
BMS_SECURITY__ACTIVE_KID=
BMS_SECURITY__SECRET_KEY=

# ===== 宿主卷（三实例互不相同；演练后连同临时工作区一起清理）=====
# 注意：cleanup 会删除这里配置的宿主目录（工作区 + 下列数据 / 位点目录），必须指向演练专用路径。
MSG_DATA_HOST_DIR_1=
MSG_OFFSETS_HOST_DIR_1=
MSG_DATA_HOST_DIR_2=
MSG_OFFSETS_HOST_DIR_2=
MSG_DATA_HOST_DIR_3=
MSG_OFFSETS_HOST_DIR_3=
# 单实例服务键位：compose 对整份文件做插值（`msg` 服务有 `:?` 必填），演练不启动它，
# 但仍须给值（指向独立演练目录，不得指向开发数据目录）
MSG_DATA_HOST_DIR=
MSG_OFFSETS_HOST_DIR=

# ===== 演练预算与记录 =====
# 单场景恢复预算（毫秒；空值沿用代码缺省）
MSG_CLUSTER_DRILL_RECOVERY_BUDGET_MS=
# 实例就绪轮询超时（秒）与远程命令超时（秒；含源码同步与镜像构建，构建慢时要放大）
MSG_CLUSTER_DRILL_READY_TIMEOUT_SEC=
MSG_CLUSTER_DRILL_SSH_TIMEOUT_SEC=
# 记录落点（相对仓根；缺省工作区根 tmp/msg/cluster-drill）
MSG_CLUSTER_DRILL_REPORT_DIR=
