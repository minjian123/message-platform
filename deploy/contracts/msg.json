{
  "components": {
    "schemas": {
      "AckRequest": {
        "additionalProperties": false,
        "description": "确认请求（位点提交值 = `offset + 1`；确认粒度到单条）。",
        "properties": {
          "group": {
            "description": "消费组名（组元数据与再均衡归 01-4）",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9._-]{1,128}$",
            "title": "Group",
            "type": "string"
          },
          "namespace": {
            "description": "命名空间（对齐 bms module_key；须为已登记且启用的模块）",
            "maxLength": 64,
            "minLength": 1,
            "title": "Namespace",
            "type": "string"
          },
          "offset": {
            "description": "待确认消息的分区内序号",
            "minimum": 0.0,
            "title": "Offset",
            "type": "integer"
          },
          "partition": {
            "description": "分区号（必带；组内分摊与再均衡归 01-4）",
            "minimum": 0.0,
            "title": "Partition",
            "type": "integer"
          },
          "topic": {
            "description": "主题名（与创建主题时的 name 同值）",
            "maxLength": 200,
            "minLength": 1,
            "title": "Topic",
            "type": "string"
          }
        },
        "required": [
          "group",
          "namespace",
          "topic",
          "partition",
          "offset"
        ],
        "title": "AckRequest",
        "type": "object"
      },
      "AckResult": {
        "additionalProperties": false,
        "description": "确认结果（`committed_offset` 为下一条待消费的 offset）。",
        "properties": {
          "committed_offset": {
            "description": "已提交位点（已处理完的最后一条 + 1）",
            "title": "Committed Offset",
            "type": "integer"
          }
        },
        "required": [
          "committed_offset"
        ],
        "title": "AckResult",
        "type": "object"
      },
      "ApiResponse": {
        "additionalProperties": false,
        "description": "统一响应体：`code=0` 成功，非 0 业务错误码。\n\n- `data` 为业务数据（泛型）；失败时为 `null`；分页载荷复用分页契约基类。\n- 雪花 ID 在 JSON 中以字符串输出（`BaseSchema` 统一序列化口径）。",
        "properties": {
          "code": {
            "default": 0,
            "title": "Code",
            "type": "integer"
          },
          "data": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Data"
          },
          "message": {
            "default": "ok",
            "title": "Message",
            "type": "string"
          }
        },
        "title": "ApiResponse",
        "type": "object"
      },
      "ApiResponse_AckResult_": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "default": 0,
            "title": "Code",
            "type": "integer"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AckResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "default": "ok",
            "title": "Message",
            "type": "string"
          }
        },
        "title": "ApiResponse[AckResult]",
        "type": "object"
      },
      "ApiResponse_ConsumeResult_": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "default": 0,
            "title": "Code",
            "type": "integer"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConsumeResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "default": "ok",
            "title": "Message",
            "type": "string"
          }
        },
        "title": "ApiResponse[ConsumeResult]",
        "type": "object"
      },
      "ApiResponse_PublishResult_": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "default": 0,
            "title": "Code",
            "type": "integer"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PublishResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "default": "ok",
            "title": "Message",
            "type": "string"
          }
        },
        "title": "ApiResponse[PublishResult]",
        "type": "object"
      },
      "ApiResponse_TopicDetail_": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "default": 0,
            "title": "Code",
            "type": "integer"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TopicDetail"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "default": "ok",
            "title": "Message",
            "type": "string"
          }
        },
        "title": "ApiResponse[TopicDetail]",
        "type": "object"
      },
      "ApiResponse_TopicItem_": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "default": 0,
            "title": "Code",
            "type": "integer"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TopicItem"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "default": "ok",
            "title": "Message",
            "type": "string"
          }
        },
        "title": "ApiResponse[TopicItem]",
        "type": "object"
      },
      "ApiResponse_TopicPage_": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "default": 0,
            "title": "Code",
            "type": "integer"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TopicPage"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "default": "ok",
            "title": "Message",
            "type": "string"
          }
        },
        "title": "ApiResponse[TopicPage]",
        "type": "object"
      },
      "ConsumeRequest": {
        "additionalProperties": false,
        "description": "拉取请求（必带 `partition`：本任务单分区投递，组内分摊归 01-4）。",
        "properties": {
          "acks": {
            "default": 1,
            "description": "投递档位：1 = 确认后才算成功（至少一次，缺省）；0 = 不等确认（可能丢）",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Acks",
            "type": "integer"
          },
          "group": {
            "description": "消费组名（组元数据与再均衡归 01-4）",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9._-]{1,128}$",
            "title": "Group",
            "type": "string"
          },
          "max_messages": {
            "default": 20,
            "description": "本次最多拉取条数（1~100）",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Max Messages",
            "type": "integer"
          },
          "namespace": {
            "description": "命名空间（对齐 bms module_key；须为已登记且启用的模块）",
            "maxLength": 64,
            "minLength": 1,
            "title": "Namespace",
            "type": "string"
          },
          "partition": {
            "description": "分区号（必带；组内分摊与再均衡归 01-4）",
            "minimum": 0.0,
            "title": "Partition",
            "type": "integer"
          },
          "topic": {
            "description": "主题名（与创建主题时的 name 同值）",
            "maxLength": 200,
            "minLength": 1,
            "title": "Topic",
            "type": "string"
          }
        },
        "required": [
          "group",
          "namespace",
          "topic",
          "partition"
        ],
        "title": "ConsumeRequest",
        "type": "object"
      },
      "ConsumeResult": {
        "additionalProperties": false,
        "description": "拉取结果（可能为空：位点已到 LEO，或剩余消息均在可见性窗口内）。",
        "properties": {
          "messages": {
            "description": "本次投递的消息（按 offset 升序）",
            "items": {
              "$ref": "#/components/schemas/MessageItem"
            },
            "title": "Messages",
            "type": "array"
          }
        },
        "title": "ConsumeResult",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MessageItem": {
        "additionalProperties": false,
        "description": "一条投递的消息（`delivery_count` 供消费端识别重复；幂等键由业务自选）。",
        "properties": {
          "delivery_count": {
            "description": "投递次数（首次 1，重投递增）",
            "title": "Delivery Count",
            "type": "integer"
          },
          "headers": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "结构化头",
            "title": "Headers",
            "type": "object"
          },
          "key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "分区键",
            "title": "Key"
          },
          "message_id": {
            "description": "消息 ID（重投保持不变）",
            "title": "Message Id",
            "type": "string"
          },
          "offset": {
            "description": "分区内序号",
            "title": "Offset",
            "type": "integer"
          },
          "partition": {
            "description": "分区号",
            "title": "Partition",
            "type": "integer"
          },
          "payload": {
            "description": "消息体（base64 编码）",
            "title": "Payload",
            "type": "string"
          },
          "published_at": {
            "description": "发布时间（UTC）",
            "format": "date-time",
            "title": "Published At",
            "type": "string"
          },
          "topic": {
            "description": "主题名",
            "title": "Topic",
            "type": "string"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "链路标识",
            "title": "Trace Id"
          }
        },
        "required": [
          "message_id",
          "topic",
          "partition",
          "offset",
          "key",
          "payload",
          "trace_id",
          "delivery_count",
          "published_at"
        ],
        "title": "MessageItem",
        "type": "object"
      },
      "PartitionItem": {
        "additionalProperties": false,
        "description": "分区明细（详情接口的 `partitions` 元素）。",
        "properties": {
          "checkpoint_hw": {
            "description": "检查点 HW",
            "title": "Checkpoint Hw",
            "type": "integer"
          },
          "checkpoint_leo": {
            "description": "检查点 LEO",
            "title": "Checkpoint Leo",
            "type": "integer"
          },
          "epoch": {
            "description": "领导者任期（复制阶段使用）",
            "title": "Epoch",
            "type": "integer"
          },
          "leader": {
            "description": "当前 leader 标识",
            "title": "Leader",
            "type": "string"
          },
          "partition_no": {
            "description": "分区号（0 起）",
            "title": "Partition No",
            "type": "integer"
          }
        },
        "required": [
          "partition_no",
          "leader",
          "checkpoint_leo",
          "checkpoint_hw",
          "epoch"
        ],
        "title": "PartitionItem",
        "type": "object"
      },
      "PublishRequest": {
        "additionalProperties": false,
        "description": "发布请求（`tenant` 不在请求体：由数据面解析链注入，防客户端自报冒充）。",
        "properties": {
          "headers": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "结构化头（trace / 业务标记）",
            "title": "Headers",
            "type": "object"
          },
          "key": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "分区键（同 key 恒同分区）",
            "title": "Key"
          },
          "namespace": {
            "description": "命名空间（对齐 bms module_key；须为已登记且启用的模块）",
            "maxLength": 64,
            "minLength": 1,
            "title": "Namespace",
            "type": "string"
          },
          "payload": {
            "default": "",
            "description": "消息体（base64 编码；空串表示空消息体）",
            "title": "Payload",
            "type": "string"
          },
          "topic": {
            "description": "主题名（与创建主题时的 name 同值）",
            "maxLength": 200,
            "minLength": 1,
            "title": "Topic",
            "type": "string"
          },
          "trace_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "链路标识",
            "title": "Trace Id"
          }
        },
        "required": [
          "namespace",
          "topic"
        ],
        "title": "PublishRequest",
        "type": "object"
      },
      "PublishResult": {
        "additionalProperties": false,
        "description": "发布结果（`message_id` 与 `offset` 解耦：前者全局唯一，后者分区内序号）。",
        "properties": {
          "message_id": {
            "description": "消息 ID（雪花，JSON 输出为字符串；重投 / 重放不变）",
            "title": "Message Id",
            "type": "string"
          },
          "offset": {
            "description": "分区内序号",
            "title": "Offset",
            "type": "integer"
          },
          "partition": {
            "description": "落到的分区号",
            "title": "Partition",
            "type": "integer"
          },
          "topic": {
            "description": "主题名",
            "title": "Topic",
            "type": "string"
          }
        },
        "required": [
          "message_id",
          "topic",
          "partition",
          "offset"
        ],
        "title": "PublishResult",
        "type": "object"
      },
      "TopicCreateRequest": {
        "additionalProperties": false,
        "description": "创建主题请求（`tenant_id` **不在请求体**：由基座解析链注入，防客户端自报冒充）。",
        "properties": {
          "cleanup_policy": {
            "default": "delete",
            "description": "清理策略（首期只支持 delete）",
            "maxLength": 16,
            "title": "Cleanup Policy",
            "type": "string"
          },
          "name": {
            "description": "主题名（建议 {域}.{对象}.{动作}）",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "namespace": {
            "description": "命名空间（对齐 bms module_key；须为已登记且启用的模块）",
            "maxLength": 64,
            "minLength": 1,
            "title": "Namespace",
            "type": "string"
          },
          "partition_count": {
            "description": "分区数（1~1024；只增不减）",
            "title": "Partition Count",
            "type": "integer"
          },
          "retention_ms": {
            "default": 2592000000,
            "description": "保留时长（毫秒；默认 30 天，上限 366 天）",
            "title": "Retention Ms",
            "type": "integer"
          }
        },
        "required": [
          "namespace",
          "name",
          "partition_count"
        ],
        "title": "TopicCreateRequest",
        "type": "object"
      },
      "TopicDetail": {
        "additionalProperties": false,
        "description": "主题详情（含分区列表）。",
        "properties": {
          "cleanup_policy": {
            "description": "清理策略",
            "title": "Cleanup Policy",
            "type": "string"
          },
          "created_at": {
            "description": "创建时间（UTC）",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "description": "主题 ID（雪花，JSON 输出为字符串）",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "description": "主题名",
            "title": "Name",
            "type": "string"
          },
          "namespace": {
            "description": "命名空间",
            "title": "Namespace",
            "type": "string"
          },
          "partition_count": {
            "description": "分区数",
            "title": "Partition Count",
            "type": "integer"
          },
          "partitions": {
            "description": "分区明细（按分区号升序）",
            "items": {
              "$ref": "#/components/schemas/PartitionItem"
            },
            "title": "Partitions",
            "type": "array"
          },
          "retention_ms": {
            "description": "保留时长（毫秒）",
            "title": "Retention Ms",
            "type": "integer"
          },
          "status": {
            "description": "状态（active / disabled）",
            "title": "Status",
            "type": "string"
          },
          "tenant_id": {
            "description": "租户内部身份（雪花，JSON 输出为字符串）",
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "tenant_id",
          "namespace",
          "name",
          "partition_count",
          "retention_ms",
          "cleanup_policy",
          "status",
          "created_at"
        ],
        "title": "TopicDetail",
        "type": "object"
      },
      "TopicItem": {
        "additionalProperties": false,
        "description": "主题明细（列表行 / 创建与查询响应的主体）。",
        "properties": {
          "cleanup_policy": {
            "description": "清理策略",
            "title": "Cleanup Policy",
            "type": "string"
          },
          "created_at": {
            "description": "创建时间（UTC）",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "description": "主题 ID（雪花，JSON 输出为字符串）",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "description": "主题名",
            "title": "Name",
            "type": "string"
          },
          "namespace": {
            "description": "命名空间",
            "title": "Namespace",
            "type": "string"
          },
          "partition_count": {
            "description": "分区数",
            "title": "Partition Count",
            "type": "integer"
          },
          "retention_ms": {
            "description": "保留时长（毫秒）",
            "title": "Retention Ms",
            "type": "integer"
          },
          "status": {
            "description": "状态（active / disabled）",
            "title": "Status",
            "type": "string"
          },
          "tenant_id": {
            "description": "租户内部身份（雪花，JSON 输出为字符串）",
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "tenant_id",
          "namespace",
          "name",
          "partition_count",
          "retention_ms",
          "cleanup_policy",
          "status",
          "created_at"
        ],
        "title": "TopicItem",
        "type": "object"
      },
      "TopicPage": {
        "additionalProperties": false,
        "description": "主题列表响应（页码分页：`page` 从 1 起，`size` 默认 20）。",
        "properties": {
          "items": {
            "description": "当前页主题",
            "items": {
              "$ref": "#/components/schemas/TopicItem"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "description": "页码（从 1 起）",
            "title": "Page",
            "type": "integer"
          },
          "size": {
            "description": "每页条数",
            "title": "Size",
            "type": "integer"
          },
          "total": {
            "description": "符合条件的总数",
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "page",
          "size"
        ],
        "title": "TopicPage",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "msg 消息平台服务",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "description": "应用信息。\n\nReturns:\n    ApiResponse: {code, message, data:{name, version}}。",
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root"
      }
    },
    "/api/v1/msg/ack": {
      "post": {
        "description": "确认一条消息（位点提交值 = `offset + 1`，提交失败不前移）。\n\n需要 msg:consume 权限；位点越界 350002，消息不在投递中 350003，\n消息已因重投超限转入死信 350007。",
        "operationId": "ack_api_v1_msg_ack_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
