                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root"
      }
    },
    "/api/v1/msg/admin/topics": {
      "get": {
        "description": "主题列表（页码分页 + 命名空间 / 名称过滤）。\n\n需要 msg:query 权限；按租户隔离；命名空间过滤值非法返回 350010。",
        "operationId": "list_topics_api_v1_msg_admin_topics_get",
        "parameters": [
          {
            "description": "命名空间过滤",
            "in": "query",
            "name": "namespace",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "命名空间过滤",
              "title": "Namespace"
            }
          },
          {
            "description": "主题名模糊匹配",
            "in": "query",
            "name": "keyword",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "主题名模糊匹配",
              "title": "Keyword"
            }
          },
          {
            "description": "页码（从 1 起）",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "description": "页码（从 1 起）",
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "description": "每页条数",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "description": "每页条数",
              "maximum": 100,
              "minimum": 1,
              "title": "Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_TopicPage_"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "无权限"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "资源不存在"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "限流"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "服务异常"
          }
        },
        "summary": "List Topics",
        "tags": [
          "msg-admin-topics"
        ],
        "x-error-codes": [
          350001,
          350010,
          350011,
          350012
        ]
      },
      "post": {
        "description": "创建主题（指定分区数，返回完整元数据）。\n\n需要 msg:manage 权限；`tenant_id` 取自基座解析链（请求体不接收）；同租户 / 命名空间下重名\n返回 350008，分区数或保留期越界返回 350009，命名空间非已启用 module_key 返回 350010。",
        "operationId": "create_topic_api_v1_msg_admin_topics_post",
