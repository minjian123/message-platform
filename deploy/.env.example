# 凭据模板（复制为 .env 使用；.env 不入库、不入镜像）
# 与 bms 基座同口径，见 bms《安全开发规范》《部署发布规范》。
# 纪律：本文件只给键位与占位，不写服务器地址、内网 IP、端口与账号；真实值只落部署态 .env 或 CI 变量。
#       键位改动须同步 deploy/compose/msg.yml 的 x-service-env（未列入锚点的键不进容器）。

# ===== 平台接入（msg 服务接入 bms 平台基础设施）=====
# 平台网络名：bms 部署创建的 Docker 网络名，由平台部署侧提供
PLATFORM_NETWORK=
# 镜像前缀与标签由发布流程注入；compose 以 :? 强制必填，无 latest 兜底
MSG_REGISTRY_IMAGE_PREFIX=<registry>/<项目路径>
MSG_TAG=<tag>

# ===== 持久化卷（消息日志与位点各一独立卷；宿主目录准备见 deploy/compose/README.md）=====
MSG_DATA_HOST_DIR=<dir>/msg/data
MSG_OFFSETS_HOST_DIR=<dir>/msg/offsets
# 三实例（cluster profile）：每实例独立 data / offsets，互不共用
MSG_DATA_HOST_DIR_1=<dir>/msg/node-1/data
MSG_OFFSETS_HOST_DIR_1=<dir>/msg/node-1/offsets
MSG_DATA_HOST_DIR_2=<dir>/msg/node-2/data
MSG_OFFSETS_HOST_DIR_2=<dir>/msg/node-2/offsets
MSG_DATA_HOST_DIR_3=<dir>/msg/node-3/data
MSG_OFFSETS_HOST_DIR_3=<dir>/msg/node-3/offsets

# ===== 六类敏感项：只从环境变量读取，配置文件、镜像与仓库均无真实值 =====
# 数据库连接串与密码（URL 模板占位 {service} / {tenant} / {database}，driver 与 host 由部署态给出）
BMS_DATABASE__PLATFORM__URL_TEMPLATE=
BMS_DATABASE__PLATFORM__PASSWORD=
BMS_DATABASE__TENANTS__URL_TEMPLATE=
BMS_DATABASE__TENANTS__PASSWORD=
BMS_DATABASE__ARCHIVE__URL=
BMS_DATABASE__ARCHIVE__PASSWORD=
# Redis URL
BMS_REDIS__URL=
# OTLP 端点
BMS_TRACER__OTLP_ENDPOINT=
# 服务令牌密钥（空值允许装配、使用时失效关闭）
BMS_SERVICE_TOKEN__KEYS=
BMS_SERVICE_TOKEN__ACTIVE_KID=
# 用户令牌密钥
BMS_SECURITY__KEYS=
BMS_SECURITY__ACTIVE_KID=
BMS_SECURITY__SECRET_KEY=
# TLS 证书路径（空值 = 不启用容器内 TLS 终止；两键须同给或同空）
BMS_SERVER__CERTFILE=
BMS_SERVER__KEYFILE=

# ===== 运行旋钮（非敏感；空值沿用代码缺省，切换环境只改本文件）=====
MSG_STORAGE_WARN_RATIO=
MSG_STORAGE_REJECT_RATIO=
MSG_STORAGE_SAMPLE_TTL_MS=

# ===== 复制运行旋钮（02-4；空值沿用代码缺省，缺省关闭复制）=====
# 复制总开关：false = 单实例（行为与 8B_02 完全一致）；true = 按副本集做 ISR 半同步
MSG_REPLICATION_ENABLED=
# 本节点标识与集群节点列表（逗号分隔；开启复制时必填，本节点须在列表内）
MSG_REPLICATION_NODE_ID=
MSG_REPLICATION_NODES=
# 副本数 / 最小同步副本数（acks=all 的门槛）
MSG_REPLICATION_FACTOR=
MSG_REPLICATION_MIN_INSYNC=
# ISR 阈值（毫秒 / 条数，任一超限即踢出）
MSG_REPLICATION_LAG_TIME_MS=
MSG_REPLICATION_LAG_RECORDS=
# follower 拉取周期 / 单次批上限 / 提交等待超时 / ISR 扫描周期 / 拓扑缓存 TTL
MSG_REPLICATION_FETCH_INTERVAL_MS=
MSG_REPLICATION_FETCH_BATCH=
MSG_REPLICATION_COMMIT_TIMEOUT_MS=
MSG_REPLICATION_SCAN_INTERVAL_MS=
MSG_REPLICATION_TOPOLOGY_TTL_MS=
# 02-5 切主：epoch / leader 刷新周期 / leader 写租约 / 切换停写宽限（宽限须 ≥ 租约）
MSG_REPLICATION_EPOCH_REFRESH_MS=
MSG_REPLICATION_LEADER_LEASE_MS=
MSG_REPLICATION_SWITCH_GRACE_MS=
# 02-9 自动选举（缺省关闭；开启要求「节拍 × 阈值 + 宽限 ≤ ISR 时间阈值」）
MSG_AUTO_ELECTION_ENABLED=
MSG_AUTO_ELECTION_DETECT_INTERVAL_MS=
MSG_AUTO_ELECTION_PROBE_TIMEOUT_MS=
MSG_AUTO_ELECTION_FAILURE_THRESHOLD=
MSG_AUTO_ELECTION_MAX_ATTEMPTS=
MSG_AUTO_ELECTION_BACKOFF_BASE_MS=
MSG_AUTO_ELECTION_BACKOFF_CAP_MS=
MSG_AUTO_ELECTION_COOLDOWN_MS=
MSG_AUTO_ELECTION_CONCURRENCY=
MSG_AUTO_ELECTION_STAGGER_MS=

# ===== 内部复制通道（02-8；单实例留空 = 不监听 8001）=====
# 内部端口 / 监听地址（单实例缺省 0；多实例必须为正且 ≠ 业务端口）
MSG_REPLICATION_INTERNAL_PORT=
MSG_REPLICATION_INTERNAL_HOST=
# 节点地址映射（node_id=http://host:port 逗号分隔；多实例必须覆盖除自身外全部节点）
MSG_REPLICATION_NODE_ENDPOINTS=
# 读 / 连接超时与单次拉取响应上限
MSG_REPLICATION_INTERNAL_TIMEOUT_MS=
MSG_REPLICATION_INTERNAL_CONNECT_TIMEOUT_MS=
MSG_REPLICATION_FETCH_MAX_BYTES=

# ===== 宿主侧备份运行旋钮（07-3-1；由 deploy/backup/ 的调度单元注入进程环境，不进服务容器）=====
# 备份根目录：宿主独立卷 / 数据盘，不与消息数据根同盘
MSG_BACKUP_DIR=
# 平台库备份产物目录（只读扫描，不复制平台库）
MSG_BACKUP_PLATFORM_DUMP_DIR=
# 位点快照保留天数（空值沿用代码缺省）
MSG_BACKUP_KEEP_DAYS=
# 可用空间估算系数（空值沿用代码缺省）
MSG_BACKUP_SPACE_FACTOR=

# ===== 宿主侧恢复演练旋钮（07-3-2；由运维命令 / 演练脚本注入进程环境，不进服务容器）=====
# 演练工作根：目标副本与临时备份根都落在这里，不得等于或位于消息数据根之下
MSG_RECOVERY_WORK_DIR=
# live 模式：停止 / 启动服务命令模板（在宿主 shell 执行；drill 模式不读）
MSG_RECOVERY_STOP_CMD=
MSG_RECOVERY_START_CMD=
# live 模式：元数据库导入命令模板，可用占位 {dump} / {backup_id} / {target_env}
MSG_RECOVERY_METADATA_CMD=
# live 模式：就绪探针地址
MSG_RECOVERY_READY_URL=
# 命令与就绪轮询超时（秒，空值沿用代码缺省）
MSG_RECOVERY_TIMEOUT_SEC=

